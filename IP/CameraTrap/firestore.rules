rules_version = '2';

// Who can do what in the database.
//   - Only signed-in team members can see anything.
//   - Sightings are created only by the Cloud Run upload service (it bypasses these rules).
//   - Team members can mark the AI's answer right/wrong, move photos to/from the Trash,
//     edit traps, and edit the animal list.
//   - Emptying the Trash is done by the Cloud Run service (it checks the login itself).
//   - Only admins (the coach) can delete traps.
//   - Nobody can read trap keys from the website.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /sightings/{id} {
      allow read: if signedIn();
      allow update: if signedIn()
        && changedOnly(['label', 'isAnimal', 'reviewed', 'reviewedBy', 'reviewedAt',
                        'trashed', 'trashReason', 'trashedBy', 'trashedAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 60
        && request.resource.data.isAnimal is bool
        && request.resource.data.reviewed is bool
        && request.resource.data.trashed is bool;
      allow delete: if isAdmin();
    }

    match /traps/{trapId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lon', 'habitat', 'placedOn', 'notes'])
        && (request.resource.data.get('lat', null) == null
            || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (request.resource.data.get('lon', null) == null
            || (request.resource.data.lon is number && request.resource.data.lon >= -180 && request.resource.data.lon <= 180));
      allow delete: if isAdmin();
    }

    match /settings/animals {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'updatedBy', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000;
    }

    match /trapKeys/{trapId} {
      allow read, write: if false;
    }

    // Photos deleted from the Trash (so they aren't uploaded again). Service only.
    match /deletedSightings/{id} {
      allow read, write: if false;
    }
  }
}
